# Didit identity verification config.
# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is gitignored. Firebase CLI loads this file when you deploy functions:
#   firebase deploy --only functions
# (Do not commit `.env` to git.)

# API key from Didit console (Settings > API Keys). Sent as the x-api-key header.
DIDIT_API_KEY=

# Workflow UUID from Didit console (Workflows). Determines which checks run.
DIDIT_WORKFLOW_ID=

# Per-destination secret_shared_key shown once when you create the webhook
# destination pointing at the deployed diditWebhook URL.
DIDIT_WEBHOOK_SECRET=

# Google Maps Platform key (server). Enable "Distance Matrix API" for this key.
# Can match your Maps JavaScript key; restrict by IP for Cloud Functions in production.
GOOGLE_MAPS_API_KEY=

# Sentiment API endpoint for review analysis (FastAPI / Cloud Run).
# Local dev: http://localhost:8000
# Production: deploy sentiment_api/Dockerfile to Cloud Run, then paste URL here.
# Example: https://neighborhelp-sentiment-xxxxx-uc.a.run.app
SENTIMENT_API_URL=

# Optional bearer token if your sentiment API is protected.
SENTIMENT_API_TOKEN=

# Optional timeout in milliseconds for sentiment API calls.
SENTIMENT_API_TIMEOUT_MS=10000
