rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function user() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && user().accountStatus == 'Active'; }
    function adminMfa() {
      return !firestore.exists(/databases/(default)/documents/securityPolicy/admin)
        || firestore.get(/databases/(default)/documents/securityPolicy/admin).data.get('requireMfa', false) != true
        || (request.auth.token.get('firebase', {}).get('sign_in_second_factor', '') is string
          && request.auth.token.get('firebase', {}).get('sign_in_second_factor', '').size() > 0);
    }
    function admin() { return active() && user().role == 'Administrator' && request.auth.token.get('email_verified', false) == true && adminMfa(); }
    function image() { return request.resource != null && request.resource.size <= 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)'); }
    match /users/{userId}/{allPaths=**} {
      allow read: if active();
      allow create, update: if active() && request.auth.uid == userId && image();
      allow delete: if active() && request.auth.uid == userId;
    }
    match /services/{providerId}/{allPaths=**} {
      allow read: if active();
      allow create, update: if active() && request.auth.uid == providerId && image();
      allow delete: if active() && request.auth.uid == providerId;
    }
    match /portfolio/{providerId}/{allPaths=**} {
      allow read: if active();
      allow create, update: if active() && request.auth.uid == providerId && image();
      allow delete: if active() && request.auth.uid == providerId;
    }
    match /certificates/{providerId}/{certificateId}/{fileName} {
      allow read: if admin() || (active() && request.auth.uid == providerId);
      allow create: if resource == null && active() && request.auth.uid == providerId && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/jpeg|image/png)');
      allow update, delete: if false;
    }
    match /messages/{bookingId}/{senderId}/{fileName} {
      function booking() { return firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data; }
      function participant() { return active() && request.auth.uid in [booking().customerId, booking().providerId]; }
      allow read: if participant();
      allow create: if false;
      allow update, delete: if false;
    }
    match /inquiries/{inquiryId}/{senderId}/{fileName} {
      function participant() { return active() && request.auth.uid in firestore.get(/databases/(default)/documents/inquiries/$(inquiryId)).data.participantIds; }
      function uploadAllowed() {
        let permitId = fileName.split('[.]')[0];
        let thread = firestore.get(/databases/(default)/documents/inquiries/$(inquiryId)).data;
        let permit = thread.uploadPermits[request.auth.uid];
        return permit.permitId == permitId && permit.expiresAt > request.time && permit.used == false
          && fileName == permitId + '.' + permit.extension
          && thread.get('blockedBy', []).size() == 0;
      }
      allow read: if participant();
      allow create: if resource == null && participant() && request.auth.uid == senderId && image() && uploadAllowed();
      allow update, delete: if false;
    }
  }
}
