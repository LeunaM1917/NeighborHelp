rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function activeUser() { return signedIn() && exists(userPath()) && get(userPath()).data.get('accountStatus', '') == 'Active'; }
    function adminMfa() {
      return !exists(/databases/$(database)/documents/securityPolicy/admin)
        || get(/databases/$(database)/documents/securityPolicy/admin).data.get('requireMfa', false) != true
        || (request.auth.token.get('firebase', {}).get('sign_in_second_factor', '') is string
          && request.auth.token.get('firebase', {}).get('sign_in_second_factor', '').size() > 0);
    }
    function isAdmin() { return activeUser() && get(userPath()).data.role == 'Administrator' && adminMfa(); }
    match /securityPolicy/admin {
      allow read: if activeUser() && get(userPath()).data.role == 'Administrator';
      allow write: if false;
    }
    function owns(id) { return activeUser() && request.auth.uid == id; }
    function actorValid() { return request.resource.data.get('updatedBy', request.auth.uid) == request.auth.uid; }
    function bookingPath(id) { return /databases/$(database)/documents/bookings/$(id); }
    function participant(id) {
      return activeUser() && exists(bookingPath(id))
        && request.auth.uid in [get(bookingPath(id)).data.customerId, get(bookingPath(id)).data.providerId];
    }
    function ownerProfileFields() {
      return ['fullName', 'contactNumber', 'profilePhotoUrl', 'address', 'location', 'bio', 'lastActive',
        'updatedAt', 'updatedBy', 'notificationPreferences', 'accountAppeal', 'accountAppealSubmittedAt'];
    }
    match /users/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == id);
      allow create: if signedIn() && request.auth.uid == id
        && request.resource.data.role in ['Customer', 'Provider']
        && (request.resource.data.role != 'Provider' || (request.resource.data.get('location', null) == null && request.resource.data.get('address', null) == null))
        && request.resource.data.accountStatus == 'Active'
        && request.resource.data.get('isVerified', false) == false
        && request.resource.data.get('verificationStatus', 'Pending') == 'Pending'
        && request.resource.data.get('diditStatus', '') == ''
        && request.resource.data.get('diditSessionId', '') == ''
        && request.resource.data.get('verificationProvider', '') == ''
        && !request.resource.data.keys().hasAny(['identitySessionKey', 'identitySessionUrl', 'identitySessionCallback', 'identitySessionExpiresAt', 'identitySessionRequestId', 'identitySessionRequestedAt', 'verificationDecision', 'verificationRetakeRequired', 'verificationIssueCodes', 'identityQualityPolicyVersion']);
      allow update: if actorValid() && (isAdmin() || (signedIn() && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(ownerProfileFields())
        && (resource.data.role != 'Provider' || (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['location'])
          && (request.resource.data.get('address', null) == null
            || (request.resource.data.address is string && request.resource.data.address.size() <= 500))))
        && (activeUser() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountAppeal', 'accountAppealSubmittedAt', 'updatedAt', 'updatedBy']))));
      // Account deletion needs a retention review; never orphan its transaction records.
      allow delete: if false;
      match /devices/{deviceId} {
        allow read, delete: if signedIn() && request.auth.uid == id;
        allow create, update: if false;
      }
    }
    // Public projection contains display information only, never private IDs/contact details.
    match /publicProfiles/{id} { allow read: if activeUser(); allow write: if false; }
    match /publicProviders/{id} { allow read: if activeUser() && resource.data.get('locationPolicyVersion', 0) == 1; allow write: if false; }
    function providerEditable() {
      return ['bio', 'education', 'educationHistory', 'employmentHistory',
        'portfolioUrls', 'portfolioProjects', 'videoIntroUrl', 'certifications', 'certificationHistory', 'approvedCertificationIds',
        'otherExperiences', 'linkedAccounts', 'profileTraits', 'weeklyAvailability', 'updatedAt', 'updatedBy'];
    }
    function certificateEditsValid() {
      return request.resource.data.get('approvedCertificationIds', []).hasOnly(resource.data.get('approvedCertificationIds', []))
        && (request.resource.data.get('certificationHistory', []) == resource.data.get('certificationHistory', [])
          || request.resource.data.get('approvedCertificationIds', []).size() == 0);
    }
    match /serviceProviders/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == id);
      allow create: if owns(id) && get(userPath()).data.role == 'Provider' && request.resource.data.userId == id
        && request.resource.data.get('location', null) == null
        && request.resource.data.get('baseBarangayId', null) == null
        && request.resource.data.get('serviceBarangayIds', []).size() == 0
        && request.resource.data.get('timeOff', []).size() == 0
        && request.resource.data.get('locationPolicyVersion', 0) == 0
        && request.resource.data.isVerified == false
        && request.resource.data.get('verificationStatus', 'Pending') == 'Pending'
        && request.resource.data.get('diditStatus', '') == ''
        && request.resource.data.get('diditSessionId', '') == ''
        && request.resource.data.get('verificationProvider', '') == ''
        && !request.resource.data.keys().hasAny(['identitySessionKey', 'identitySessionUrl', 'identitySessionCallback', 'identitySessionExpiresAt', 'identitySessionRequestId', 'identitySessionRequestedAt', 'verificationDecision', 'verificationRetakeRequired', 'verificationIssueCodes', 'identityQualityPolicyVersion'])
        && request.resource.data.get('averageRating', 0) == 0
        && request.resource.data.get('reviewCount', 0) == 0
        && request.resource.data.get('acceptedBookings', 0) == 0
        && request.resource.data.get('completedBookings', 0) == 0
        && request.resource.data.get('approvedCertificationIds', []).size() == 0
        && !request.resource.data.keys().hasAny(['approvedServiceProposals']);
      allow update: if actorValid() && (isAdmin() || (owns(id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(providerEditable()) && certificateEditsValid()));
      allow delete: if false;
    }
    function providerVerified(id) {
      return exists(/databases/$(database)/documents/serviceProviders/$(id))
        && get(/databases/$(database)/documents/serviceProviders/$(id)).data.isVerified == true
        && get(/databases/$(database)/documents/users/$(id)).data.accountStatus == 'Active';
    }
    function providerSetupReady(id) {
      let user = get(/databases/$(database)/documents/users/$(id)).data;
      let profile = get(/databases/$(database)/documents/serviceProviders/$(id)).data;
      return providerVerified(id) && user.role == 'Provider'
        && user.get('fullName', '').size() >= 2
        && user.get('contactNumber', '') is string
        && user.get('contactNumber', '').matches('^[+0-9][0-9 ()-]{6,19}$')
        && profile.get('locationPolicyVersion', 0) == 1
        && profile.get('baseBarangayId', '') is string
        && profile.get('baseBarangayId', '').size() > 0
        && profile.get('serviceBarangayIds', []).size() > 0;
    }
    function approvedServiceProposal(s, id) {
      let key = s.get('serviceProposalId', '');
      let profile = get(/databases/$(database)/documents/serviceProviders/$(s.providerId)).data;
      let grant = profile.get('approvedServiceProposals', {}).get(key, {});
      return key is string && key.size() == 64
        && grant.get('status', '') == 'Approved' && grant.get('serviceId', '') == id
        && grant.get('category', '') == s.category && grant.get('serviceTitle', '') == s.serviceTitle;
    }
    function supportedService(s, id) {
      return s.get('priceType','') in ['hourly','fixed','daily','negotiable'] && (
        (s.category == 'Home Repair' && s.serviceTitle in ['Basic Carpentry','Carpentry','Door Repair','Furniture Repair'])
        || (s.category == 'Cleaning' && s.serviceTitle in ['House Cleaning','Apartment Cleaning','Kitchen Cleaning','Bathroom Cleaning','Laundry Assistance','Ironing Service'])
        || (s.category == 'Repair and Technical Services' && s.serviceTitle in ['Electrical Repair','Plumbing Repair','Computer Repair','Laptop Repair','Internet/Wi-Fi Setup','Aircon Cleaning','Aircon Repair','Refrigerator Repair'])
        || (s.category == 'Handyman' && s.serviceTitle in ['Furniture Assembly','Shelf Installation'])
        || approvedServiceProposal(s, id));
    }
    match /services/{id} {
      allow read: if activeUser();
      allow create: if owns(request.resource.data.providerId)
        && supportedService(request.resource.data, id)
        && request.resource.data.approvalStatus in ['Draft', 'Pending']
        && (request.resource.data.approvalStatus == 'Draft' || providerSetupReady(request.auth.uid))
        && request.resource.data.isActive == false;
      allow update: if actorValid() && (isAdmin() || (owns(resource.data.providerId)
        && ((request.resource.data.approvalStatus == 'Draft' && request.resource.data.isActive == false)
          || providerSetupReady(request.auth.uid)
          || (request.resource.data.isActive == false && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive','updatedAt','updatedBy'])))
        && (supportedService(request.resource.data, id) || (request.resource.data.isActive == false && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive','updatedAt','updatedBy'])) )
        && request.resource.data.providerId == resource.data.providerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['serviceTitle', 'category', 'description', 'estimatedPrice',
          'priceType', 'estimatedDuration', 'availability', 'serviceImages', 'requiresCertification', 'approvalStatus', 'isActive', 'rejectionReason', 'updatedAt', 'updatedBy'])
        && (request.resource.data.approvalStatus in ['Draft', 'Pending'] && request.resource.data.isActive == false
          || (request.resource.data.approvalStatus == resource.data.approvalStatus
            && resource.data.approvalStatus == 'Approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'updatedAt', 'updatedBy'])))));
      allow delete: if isAdmin() || owns(resource.data.providerId);
    }
    match /serviceProposals/{id} {
      allow read: if isAdmin() || owns(resource.data.providerId);
      allow write: if false;
    }
    // Only validated server commands may change booking money, participants or status.
    match /bookings/{id} {
      allow read: if isAdmin() || (activeUser() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid));
      allow write: if false;
      match /{recordType}/{recordId} {
        allow read: if recordType in ['workEvents', 'amendments', 'agreementVersions', 'payments', 'settlements'] && (isAdmin() || participant(id));
        allow write: if false;
      }
    }
    match /providerSchedules/{id} { allow read, write: if false; }
    match /inquiries/{id} {
      function canReadThread(thread) {
        return activeUser() && request.auth.uid in thread.participantIds
          && (get(userPath()).data.role != 'Administrator' || isAdmin());
      }
      allow read: if canReadThread(resource.data);
      allow write: if false;
      match /messages/{messageId} {
        allow read: if canReadThread(get(/databases/$(database)/documents/inquiries/$(id)).data)
          && (get(/databases/$(database)/documents/inquiries/$(id)).data.get('kind', '') != 'dispute'
            || request.auth.uid != get(/databases/$(database)/documents/inquiries/$(id)).data.get('assignedAdminId', '') || isAdmin());
        allow write: if false;
      }
    }
    match /contracts/{id} {
      allow read: if isAdmin() || (activeUser() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid));
      allow write: if false;
    }
    match /workCases/{id} {
      allow read: if isAdmin() || (activeUser() && request.auth.uid in resource.data.participantIds);
      allow write: if false;
      match /events/{eventId} {
        allow read: if isAdmin() || (activeUser() && request.auth.uid in get(/databases/$(database)/documents/workCases/$(id)).data.participantIds);
        allow write: if false;
      }
    }
    match /bookingUserReports/{id} {
      function reportReader(report) {
        return isAdmin() || (activeUser()
          && (report.get('reporterId', '') == request.auth.uid || report.get('reportedUserId', '') == request.auth.uid));
      }
      allow read: if reportReader(resource.data);
      allow write: if false;
      match /events/{eventId} {
        allow read: if reportReader(get(/databases/$(database)/documents/bookingUserReports/$(id)).data);
        allow write: if false;
      }
    }
    match /messages/{id} {
      allow read: if activeUser() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if false;
      allow update: if owns(resource.data.receiverId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) && request.resource.data.isRead == true;
      allow delete: if false;
    }
    match /reviews/{id} {
      allow read: if activeUser();
      allow write: if false;
    }
    match /notifications/{id} {
      allow read: if isAdmin() || owns(resource.data.userId);
      allow create: if isAdmin() && request.resource.data.userId is string
        && request.resource.data.title is string && request.resource.data.message is string;
      allow update: if (isAdmin() || owns(resource.data.userId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) && request.resource.data.isRead == true;
      allow delete: if false;
    }
    match /scheduledAnnouncements/{id} { allow read: if isAdmin(); allow write: if false; }
    match /auditLogs/{id} { allow read: if isAdmin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
